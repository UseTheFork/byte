{
  "$schema": "https://raw.githubusercontent.com/UseTheFork/byte/refs/heads/development/schema.json",
  "llm": {
    "reasoning": {
      "model": "google/gemini-2.5-pro",
      "provider": "openrouter",
      "extra_params": {
        "reasoning": {
          "effort": "minimal",
        },
      },
    },
    "standard": {
      "model": "google/gemini-2.5-pro",
      "provider": "openrouter",
      "extra_params": {
        "reasoning": {
          "effort": "minimal",
        },
      },
    },
    "coding": {
      "model": "anthropic/claude-haiku-4.5",
      "provider": "openrouter",
    },
    "fast": {
      "model": "anthropic/claude-haiku-4.5",
      "provider": "openrouter",
    },
  },
  "gateway": {
    "enable": true,
  },
  "git": {
    "enable_body": false,
  },
  "lint": {
    "enable": true,
    "commands": [
      {
        "command": ["hk", "run", "fix"],
        "languages": ["*"],
      },
    ],
  },
  "files": {
    "ignore": [
      ".byte",
      ".ruff_cache",
      ".idea",
      ".venv",
      ".env",
      ".git",
      ".pytest_cache",
      "__pycache__",
      "node_modules",
    ],
    "watch": {
      "enable": true,
    },
  },
  "tui": {
    "ui_theme": "mocha",
    "syntax_theme": "github-dark",
  },
  "lsp": {
    "enable": false,
    "timeout": 30,
    "servers": {
      "python": {
        "preset": "ty",
        "server_type": "local",
        "languages": ["python"],
      },
    },
  },
}
